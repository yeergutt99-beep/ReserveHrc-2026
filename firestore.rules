rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function isAdmin() {
      return isSignedIn() && userDoc(request.auth.uid).data.role == 'admin';
    }

    function sameCompany(companyId) {
      return isSignedIn() && userDoc(request.auth.uid).data.companyId == companyId;
    }

    function validReservation(data, companyId) {
      return data.companyId == companyId
        && data.peopleCount is int
        && data.peopleCount > 0
        && data.peopleCount <= 500
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.date is string
        && data.time is string
        && (!('contact' in data) || data.contact is string)
        && (!('comments' in data) || data.comments is string)
        && (!('source' in data) || data.source is string)
        && (!('expiresAt' in data) || data.expiresAt is timestamp);
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin() && request.resource.data.companyId is string;
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /companies/{companyId}/reservations/{reservationId} {
      allow read: if sameCompany(companyId);
      allow create: if sameCompany(companyId)
        && validReservation(request.resource.data, companyId);
      allow update: if sameCompany(companyId)
        && validReservation(request.resource.data, companyId);
      allow delete: if isAdmin() && sameCompany(companyId);
    }

    match /companies/{companyId}/sofiaConversations/{conversationId} {
      allow read: if sameCompany(companyId);
      allow write: if false;

      match /messages/{messageId} {
        allow read: if sameCompany(companyId);
        allow write: if false;
      }
    }

    match /companies/{companyId}/sofiaInformation/{documentId} {
      allow read: if sameCompany(companyId);
      allow create: if isAdmin()
        && sameCompany(companyId)
        && request.resource.data.companyId == companyId;
      allow update: if isAdmin()
        && sameCompany(companyId)
        && request.resource.data.companyId == companyId;
      allow delete: if false;
    }
  }
}
